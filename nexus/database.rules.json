{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'nickname', 'room', 'online', 'lastSeen'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "nickname": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20"
        },
        "room": {
          ".validate": "newData.val() === 'general' || newData.val() === 'gamers' || newData.val() === 'hudba' || newData.val() === 'random' || newData.val() === 'nexus-ai'"
        },
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
