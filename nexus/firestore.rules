rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validRoom(roomId) {
      return roomId in ['general', 'gamers', 'hudba', 'random', 'nexus-ai'];
    }

    function validReply(reply) {
      return reply == null
        || (
          reply is map
          && reply.keys().hasOnly(['authorUid', 'nickname', 'text'])
          && reply.keys().hasAll(['authorUid', 'nickname', 'text'])
          && reply.authorUid is string
          && reply.nickname is string
          && reply.nickname.size() >= 2
          && reply.nickname.size() <= 20
          && reply.text is string
          && reply.text.size() > 0
          && reply.text.size() <= 2000
        );
    }

    match /rooms/{roomId}/messages/{messageId} {
      allow read: if request.auth != null && validRoom(roomId);

      allow create: if request.auth != null
        && validRoom(roomId)
        && request.resource.data.keys().hasOnly([
          'authorUid', 'nickname', 'text', 'timestamp', 'reactions', 'replyTo'
        ])
        && request.resource.data.keys().hasAll([
          'authorUid', 'nickname', 'text', 'timestamp', 'reactions', 'replyTo'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.timestamp is timestamp
        && request.resource.data.reactions is map
        && request.resource.data.reactions.size() == 0
        && validReply(request.resource.data.replyTo);

      allow update: if request.auth != null
        && validRoom(roomId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions is map
        && request.resource.data.reactions.size() <= 100
        && resource.data.reactions is map
        && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
        && (
          !request.resource.data.reactions.keys().hasAny([request.auth.uid])
          || request.resource.data.reactions[request.auth.uid] in ['👍', '❤️', '😂', '😮', '😢', '🔥']
        );

      allow delete: if request.auth != null
        && validRoom(roomId)
        && resource.data.authorUid == request.auth.uid;
    }
  }
}
